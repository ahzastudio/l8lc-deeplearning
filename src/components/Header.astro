---
---
<header class="absolute top-0 left-0 w-full z-50 py-6">
  <div class="container mx-auto px-6 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-4 group">
      <img src="/logo-ahza.png" alt="Ahza Studio Logo" class="h-14 w-auto group-hover:brightness-110 transition-all shadow-xl shadow-emerald-900/20 rounded-xl" />
      <div class="flex flex-col">
        <span class="font-extrabold text-xl leading-none text-white group-hover:text-emerald-400 transition-colors tracking-tight">Ahza Studio</span>
        <span class="text-[0.65rem] font-bold tracking-[0.2em] text-emerald-500 uppercase mt-1">Deep Learning Toolbox</span>
      </div>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/#features" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Features</a>
      <a href="/#showcase" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Interface</a>
      <a href="/#download" class="text-sm font-medium text-slate-300 hover:text-white transition-colors">Pricing</a>
      
      <!-- Docs Link -->
      <a href="/docs" class="relative group px-4 py-2">
        <span class="relative z-10 text-sm font-semibold text-white group-hover:text-emerald-300 transition-colors">Documentation</span>
        <div class="absolute inset-0 bg-white/5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity blur-sm"></div>
      </a>
    </nav>

    <!-- Mobile Menu Button (Placeholder) -->
    <button class="md:hidden text-white/70 hover:text-white">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>
