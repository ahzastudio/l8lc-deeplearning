---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Order Pro Edition - Deep Learning Toolbox">
	<main class="min-h-screen relative overflow-hidden flex items-center justify-center p-6">
		
		<!-- Background Gradients -->
		<div class="fixed inset-0 pointer-events-none z-0">
			<div class="absolute top-[-20%] left-[-20%] w-[60%] h-[60%] bg-emerald-500/10 rounded-full blur-[150px]"></div>
			<div class="absolute bottom-[-20%] right-[-20%] w-[60%] h-[60%] bg-blue-500/10 rounded-full blur-[150px]"></div>
		</div>

		<div class="relative z-10 w-full max-w-4xl grid md:grid-cols-2 gap-8 items-start">
			
			<!-- Left Column: Product Summary -->
			<div class="glass-card p-8 rounded-3xl border border-white/10 space-y-6">
				<div>
					<span class="text-xs font-bold tracking-widest text-emerald-400 uppercase">Order Summary</span>
					<h1 class="text-3xl font-bold text-white mt-2">Pro Edition License</h1>
					<p class="text-slate-400 text-sm mt-2">Deep Learning Land Cover Toolbox v2.0</p>
				</div>

				<div class="py-6 border-y border-white/10 space-y-4">
					<div class="flex justify-between text-sm">
						<span class="text-slate-300">Lifetime License</span>
						<span class="text-white font-medium">Rp 349.000</span>
					</div>
					<div class="flex justify-between text-sm">
						<span class="text-slate-300">Support & Updates</span>
						<span class="text-emerald-400 font-medium">Included</span>
					</div>
					<div class="flex justify-between text-sm">
						<span class="text-slate-300">Tax</span>
						<span class="text-white font-medium">Rp 0</span>
					</div>
				</div>

				<div class="flex justify-between items-center">
					<span class="text-slate-300 font-medium">Total</span>
					<span class="text-4xl font-bold text-emerald-400">Rp 349.000</span>
				</div>

				<div class="bg-blue-500/10 border border-blue-500/20 p-4 rounded-xl text-xs text-blue-200 leading-relaxed">
					<strong class="block mb-1 text-blue-400">Secure Payment via WhatsApp</strong>
					Setelah mengisi formulir, Anda akan diarahkan ke WhatsApp untuk konfirmasi pembayaran dan aktivasi lisensi.
				</div>
			</div>

			<!-- Right Column: Order Form -->
			<div class="bg-slate-900/50 backdrop-blur-md p-8 rounded-3xl border border-white/10 shadow-2xl">
				<h2 class="text-xl font-bold text-white mb-6">Informasi Pemesan</h2>
				
				<form id="orderForm" class="space-y-5">
					<div>
						<label for="name" class="block text-sm font-medium text-slate-400 mb-2">Nama Lengkap</label>
						<input type="text" id="name" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-white placeholder-slate-600 outline-none transition-all" placeholder="Contoh: Budi Santoso" />
					</div>

					<div>
						<label for="email" class="block text-sm font-medium text-slate-400 mb-2">Alamat Email</label>
						<input type="email" id="email" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-white placeholder-slate-600 outline-none transition-all" placeholder="nama@email.com" />
					</div>

					<div>
						<label for="whatsapp" class="block text-sm font-medium text-slate-400 mb-2">Nomor WhatsApp</label>
						<div class="flex">
							<span class="inline-flex items-center px-4 bg-white/5 border border-r-0 border-white/10 rounded-l-xl text-slate-400">+62</span>
							<input type="tel" id="whatsapp" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-r-xl focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 text-white placeholder-slate-600 outline-none transition-all" placeholder="81234567890" />
						</div>
					</div>

					<div class="pt-4">
						<button type="submit" class="w-full py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 group">
							<span>Lanjut ke Pembayaran</span>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
							</svg>
						</button>
						<p class="text-center text-xs text-slate-500 mt-4">Data Anda aman dan terenkripsi.</p>
					</div>
				</form>
			</div>

		</div>
	</main>
</Layout>

<script>
	const form = document.getElementById('orderForm');
	
	form.addEventListener('submit', (e) => {
		e.preventDefault();
		
		const name = document.getElementById('name').value;
		const email = document.getElementById('email').value;
		const whatsapp = document.getElementById('whatsapp').value;
		
		// Format Message
		const message = `Halo Admin Ahza Studio, saya ingin membeli lisensi *Deep Learning Land Cover Toolbox v2.0* (Pro Edition).%0A%0A-------- Detail Pesanan --------%0A👤 Nama: ${name}%0A📧 Email: ${email}%0A📱 WA: 0${whatsapp}%0A💵 Total: Rp 349.000%0A----------------------------------%0A%0AMohon info rekening pembayarannya. Terima kasih!`;
		
		// Redirect to WhatsApp
		const waLink = `https://wa.me/6282254760769?text=${message}`;
		window.open(waLink, '_blank');
	});
</script>
