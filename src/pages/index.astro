---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Showcase from '../components/Showcase.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Deep Learning Land Cover Toolbox v2.1.1 - Ahza Studio">
	<main class="relative overflow-hidden w-full">
		
		<Hero />
		
		<!-- Tech Stack Divider / Logos -->
		<div class="border-y border-white/5 bg-white/5 backdrop-blur-sm py-8">
			<div class="container mx-auto px-6 flex flex-wrap justify-center gap-12 opacity-50 grayscale hover:grayscale-0 transition-all duration-500">
				<!-- Logos represented as text for now, assuming vector assets later -->
				<span class="text-xl font-bold tracking-widest text-white">ARCGIS PRO</span>
				<span class="text-xl font-bold tracking-widest text-white">PYTORCH</span>
				<span class="text-xl font-bold tracking-widest text-white">FAST.AI</span>
				<span class="text-xl font-bold tracking-widest text-white">LANDSAT 8</span>
				<span class="text-xl font-bold tracking-widest text-white">PYTHON</span>
			</div>
		</div>

		<!-- Screenshots Showcase -->
		<Showcase />

		<!-- Features Grid -->
		<Features />

		<!-- Pricing / Download Section (Freemium Style) -->
		<section id="download" class="py-24 relative">
			<div class="absolute inset-0 bg-gradient-to-b from-transparent to-emerald-900/20 pointer-events-none"></div>
			<div class="container mx-auto px-6 relative z-10">
				
				<div class="text-center max-w-3xl mx-auto mb-16">
					<h2 class="text-4xl font-bold mb-4">Choose Your <span class="text-gradient">Power</span></h2>
					<p class="text-slate-400">Start for free with our robust Mosaic Engine, or upgrade to Pro for AI Classification.</p>
				</div>

				<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto items-start">
					
					<!-- FREE TIER -->
					<div class="glass-card p-8 rounded-3xl border border-white/10 hover:border-emerald-500/30 transition-all flex flex-col">
						<div class="mb-4">
							<span class="text-xs font-bold tracking-wider text-slate-400 uppercase">Starter</span>
							<h3 class="text-3xl font-bold text-white mt-2">Mosaic Tool</h3>
							<div class="flex items-baseline gap-1 my-4">
								<span class="text-4xl font-bold text-white">Free</span>
								<span class="text-slate-500">/ forever</span>
							</div>
							<p class="text-slate-400 text-sm">Perfect for data preparation and organizing Landsat 8 Level 1 & Level 2 imagery.</p>
						</div>
						
						<ul class="space-y-3 mb-8 flex-grow">
							<li class="flex items-center gap-3 text-slate-300 text-sm">
								<svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								Smart Mosaic Engine
							</li>
							<li class="flex items-center gap-3 text-slate-300 text-sm">
								<svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								Auto-check Dependencies
							</li>
							<li class="flex items-center gap-3 text-slate-300 text-sm">
								<svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
								Metadata Auto-Parsing
							</li>
						</ul>

						<a href="/downloads/DeepLearningLandCover_v2.1.1.zip" class="block w-full py-3 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl text-center transition-all">
							Download Basic (.zip)
						</a>
						<p class="text-xs text-center text-slate-500 mt-2">Includes .pyt toolbox only</p>
					</div>

					<!-- PRO TIER -->
					<div class="glass-card p-8 rounded-3xl border border-emerald-500/50 bg-emerald-900/10 relative overflow-hidden flex flex-col transform md:-translate-y-4 shadow-2xl shadow-emerald-500/10">
						<div class="absolute top-0 right-0 bg-emerald-500 text-white text-xs font-bold px-3 py-1 rounded-bl-xl">
							BEST VALUE
						</div>
						
						<div class="mb-4 relative z-10">
							<span class="text-xs font-bold tracking-wider text-emerald-400 uppercase">Lifetime License</span>
							<h3 class="text-3xl font-bold text-white mt-2">Pro Edition</h3>
							<div class="flex flex-col gap-2 my-4">
								<div class="flex items-center gap-2">
									<span class="text-sm text-slate-500 line-through font-medium">Rp 750.000</span>
									<span class="text-[10px] bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-full font-bold tracking-wider uppercase anim-pulse">Promo Launching</span>
								</div>
								<div class="flex items-baseline gap-1">
									<span class="text-4xl font-bold text-emerald-400">Rp 349.000</span>
									<span class="text-slate-500 text-sm">/ seumur hidup</span>
								</div>
							</div>
							<p class="text-slate-300 text-sm">One-time payment. Upgrade to unlock AI Classification forever.</p>
						</div>

						<ul class="space-y-3 mb-8 relative z-10">
							<li class="flex items-center gap-3 text-white text-sm font-medium">
								<div class="bg-emerald-500/20 p-1 rounded-full"><svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>
								<strong>Unlock Deep Learning Forever</strong>
							</li>
							<li class="flex items-center gap-3 text-white text-sm font-medium">
								<div class="bg-emerald-500/20 p-1 rounded-full"><svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>
								Auto-Vectorization (SNI Standard)
							</li>
							<li class="flex items-center gap-3 text-white text-sm font-medium">
								<div class="bg-emerald-500/20 p-1 rounded-full"><svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>
								Advanced GPU Optimization
							</li>
							<li class="flex items-center gap-3 text-white text-sm font-medium">
								<div class="bg-emerald-500/20 p-1 rounded-full"><svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg></div>
								Lifetime Support & Updates
							</li>
						</ul>

						<a href="/order" class="block w-full py-4 bg-emerald-500 hover:bg-emerald-400 text-white font-bold rounded-xl text-center shadow-lg hover:shadow-emerald-500/50 transition-all transform hover:scale-[1.02] relative z-10">
							Beli Sekarang
						</a>
						
						<!-- Glow FX -->
						<div class="absolute inset-0 bg-emerald-500/5 blur-3xl group-hover:bg-emerald-500/10 transition-all duration-700"></div>
					</div>

				</div>

				<!-- SUPPORTING DATA (DLPK) -->
				<div class="max-w-4xl mx-auto mt-16 p-8 rounded-3xl bg-slate-800/50 border border-white/10 backdrop-blur-sm relative overflow-hidden group hover:border-emerald-500/30 transition-all">
					<div class="absolute inset-0 bg-gradient-to-r from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
					
					<div class="relative z-10">
						<div class="flex items-center gap-3 mb-4">
							<div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
								</svg>
							</div>
							<h3 class="text-2xl font-bold text-white">Data Pendukung (Wajib untuk AI)</h3>
						</div>
						
						<p class="text-slate-400 mb-6 max-w-2xl">
							Untuk menggunakan fitur <strong>Deep Learning Classification</strong> (Paket PRO / Trial), Anda perlu download file model AI pendukung berikut.
							File ini hanya perlu diunduh <strong>sekali</strong> dan diletakkan di folder yang sama dengan toolbox.
						</p>

						<div class="bg-black/30 rounded-xl p-6 border border-white/5 flex flex-col md:flex-row items-center justify-between gap-6">
							<div class="flex items-center gap-4">
								<div class="w-12 h-12 rounded-lg bg-blue-500/20 flex items-center justify-center text-blue-400 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
										<path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" />
									</svg>
								</div>
								<div>
									<div class="font-mono text-emerald-400 text-sm mb-1">File: LandCoverClassification.dlpk</div>
									<ul class="text-xs text-slate-500 space-y-1">
										<li>• Ukuran: ~150 MB</li>
										<li>• Diperlukan untuk: <strong>Tool 02. Classify Land Cover</strong></li>
									</ul>
								</div>
							</div>
							
							<a href="https://drive.google.com/uc?export=download&id=1kAdbTwe7Mk71hILu543uNwc6HRfT3k4H" class="shrink-0 px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
								</svg>
								Download Model AI (150MB)
							</a>
						</div>
						
						<div class="mt-4 flex gap-2 text-xs text-amber-500/80 items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
							</svg>
							<span>Catatan: Jika Anda hanya menggunakan fitur Free (Mosaic Tool), file ini tidak diperlukan.</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<Footer />
		
	</main>
</Layout>
